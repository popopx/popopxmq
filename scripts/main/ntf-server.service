[Unit]
Description=NTF server

[Service]
User=ntf
Group=ntf
Type=simple

ExecStart=/usr/local/bin/ntf-server start +RTS -N -RTS
ExecStopPost=/usr/local/bin/popopx-servers-stopscript ntf-server

LimitNOFILE=65535
KillSignal=SIGINT

TimeoutStartSec=infinity
TimeoutStopSec=infinity

Restart=on-failure
RestartSec=10s
StartLimitBurst=3
StartLimitInterval=60s

AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
