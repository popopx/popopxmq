flag swift
  description: Enable swift JSON format
  manual: True
  default: False

flag use_crypton
  description: Use crypton etc. in cryptostore
  manual: True
  default: True

flag client_library
  description: Don't build server-related code.
  manual: True
  default: False

flag client_postgres
  description: Build with PostgreSQL instead of SQLite.
  manual: True
  default: False

flag server_postgres
  description: Build server with support of PostgreSQL.
  manual: True
  default: False

flag commoncrypto
  description: On Apple platforms, use SecRandomCopyBytes (Security.framework) for libbbs randomness. getentropy is a non-public symbol on iOS and triggers App Store rejection (ITMS-90338).
  manual: True
  default: False

